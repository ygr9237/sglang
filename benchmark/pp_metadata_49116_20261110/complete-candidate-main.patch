+
+        for values in ([], [1, 2], [1.25, 2.5], [1, 2.5]):
+            with self.subTest(values=values):
+                expected = values.copy()
+                frozen = _pp_freeze_output_metadata(values)
+                self.assertIsNot(frozen, values)
+                self.assertEqual(frozen, expected)
+                values.append(99)
+                values[0] = -1
+                self.assertEqual(frozen, expected)
