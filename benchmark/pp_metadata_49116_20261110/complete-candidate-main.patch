+        self.assertIsInstance(wire["rows"][0], tuple)
+        self.assertEqual(wire["rows"][0][1:], (None, 7, False))
+        base.zero_()
+        self.assertEqual(wire["rows"][0][0].tolist(), [500, 501])
+        self.assertEqual(wire["rows"][0][0].untyped_storage().nbytes(), 16)
